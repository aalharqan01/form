{
  "name": "form",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:roles": "node --experimental-strip-types scripts/dev-roles.mjs",
    "dev:phones": "node scripts/preview-phones.mjs",
    "build": "vinext build && node scripts/prepare-offline.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types --test tests/fitness.test.mjs tests/coaching.test.mjs",
    "test:api": "node --experimental-strip-types tests/api-check.mjs",
    "setup": "npm ci && npm run db:local",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.json",
    "db:seed": "node --experimental-strip-types scripts/seed-local.mjs",
    "test:roles": "node --experimental-strip-types --test tests/local-roles.test.mjs",
    "test:e2e": "playwright test",
    "mobile:setup": "npm --prefix mobile ci",
    "mobile:web": "npm --prefix mobile run web",
    "mobile:ios": "node scripts/ios-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test:access": "node --experimental-strip-types --test tests/access.test.mjs",
    "cloudflare:configure": "node scripts/configure-cloudflare.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "cloudflare:check": "node scripts/check-cloudflare.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "jose": "6.2.12",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
