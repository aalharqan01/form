{
  "name": "form-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.21",
    "expo-crypto": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --ios --host localhost --port 8081",
    "web": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --web --host localhost --port 8081",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web"
  },
  "private": true
}
